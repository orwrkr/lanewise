#!/bin/sh
# The last stop before commits leave this machine (AGENTS.md). Enable once per clone: git config core.hooksPath .githooks
guard="$(dirname "$0")/../plugins/orchestra/tests/check_portable.py"
for p in python3 python py; do
  if command -v "$p" >/dev/null 2>&1 && "$p" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' 2>/dev/null; then
    exec "$p" "$guard" --push
  fi
done
echo "pre-push: Python >= 3.8 not found; the portability guard did not run" >&2
