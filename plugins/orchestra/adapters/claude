#!/usr/bin/env python3
# Orchestra adapter: Claude as an external executor (headless Claude Code on your own Claude login).
#
# In a Claude-led session Claude workers are the plugin's subagents (orch-*). This adapter is the Claude lane when the
# lead is another model (`orch launch deepseek`): every in-session request of such a lead goes to its own API, so work
# for Claude goes out through `orch run claude`. `orch profile use claude off` (or `orch launch … --no-claude`) turns
# Claude off completely: orch refuses these runs, and the skill keeps Claude subagents out of a Claude-led session.
#
# Isolation as for the deepseek executor, but on your Claude config (that is where the login lives):
#   - --setting-sources user + disableAllHooks: no hooks, no settings of the target repo (its CLAUDE.md and AGENTS.md
#     come from orch); --strict-mcp-config: no MCP servers; auto-memory and session files off;
#   - variables of the orchestrating session are stripped, including a non-Claude lead's endpoint and token;
#   - --permission-mode dontAsk with the analysis / write tool rules of the deepseek executor.
# Auth: your `claude` login (subscription). A profile may use another config dir (home=CLAUDE_CONFIG_DIR; log in there
# once: CLAUDE_CONFIG_DIR=<dir> claude) or an API key (--key VAR → ANTHROPIC_API_KEY, billed per token).
# Models: aliases haiku | sonnet | opus | fable or full model ids; registry slot claude/<alias>-<effort>.
#
# orch-secrets: ANTHROPIC_API_KEY
# orch-secrets-explicit: ANTHROPIC_API_KEY
# orch-limit-detect: exit-code
# orch-profile-env: home=CLAUDE_CONFIG_DIR
# Contract: adapters/_template.example. Exit 75 = usage limit (reset time → $ORCH_RUN_DIR/quota_until).
# Overrides: ORCH_CLAUDE_BIN, ORCH_CLAUDE_EXTRA_ARGS.
import datetime as dt
import json
import os
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
sys.dont_write_bytecode = True        # no __pycache__ inside the plugin's adapters/
import _claude_headless as H  # noqa: E402

DEFAULT_MODEL = "sonnet"
CLAUDE_MODEL_ALIASES = ("haiku", "sonnet", "opus", "fable", "opusplan", "default", "best")
LIMIT_RE = re.compile(r"usage limit|hit your (?:usage )?limit|limit reached|out of (?:extra )?usage|rate.?limit", re.I)
RESET_EPOCH = re.compile(r"\|(\d{10})\b")
RESET_IN = re.compile(r"(?:resets?|try again)\s+in\s+(\d+)\s*(minute|min|hour|hr|h|m)", re.I)
RESET_AT = re.compile(r"resets?\s+(?:at\s+)?(\d{1,2})(?::(\d{2}))?\s*(am|pm)?\b", re.I)


def say(msg):
    print("[claude] " + msg, flush=True)


def normalize_endpoint(url):
    """scheme://host[:port]/path with a lowercase host and no trailing slash, as orch compares them; None if no URL."""
    from urllib.parse import urlsplit
    try:
        p = urlsplit(str(url or "").strip())
        port = p.port
    except ValueError:
        return None
    scheme = p.scheme.lower()
    if scheme not in ("http", "https") or not p.hostname:
        return None
    host = p.hostname.lower()
    if port is not None and (scheme, port) not in (("http", 80), ("https", 443)):
        host += ":%d" % port
    return "%s://%s%s" % (scheme, host, p.path.rstrip("/"))


def lead_endpoints():
    """Endpoints of other providers that can lead a session (`# orch-endpoint:` in an adapter, here or in
    ~/.orchestra/adapters). A gateway or proxy to Claude itself is not among them."""
    out = set()
    home = Path(os.environ.get("ORCH_HOME") or (Path.home() / ".orchestra"))
    for base in (Path(__file__).resolve().parent, home / "adapters"):
        try:
            files = [f for f in base.iterdir() if f.is_file() and not f.name.startswith((".", "_"))]
        except OSError:
            continue
        for f in files:
            try:
                with f.open(encoding="utf-8", errors="replace") as fh:
                    head = [next(fh, "") for _ in range(60)]
            except OSError:
                continue
            for line in head:
                if line.startswith("# orch-endpoint:"):
                    key = normalize_endpoint(line.split(":", 1)[1])
                    if key:
                        out.add(key)
    return out


def claude_model(name):
    m = name.strip().lower()
    return "claude" in m or m.split("[", 1)[0] in CLAUDE_MODEL_ALIASES


def user_settings_problem(config_dir):
    """The `env` of the user settings this executor reloads (`--setting-sources user`) when it would take the worker
    off Claude: another provider's lead endpoint, or a model that is not Claude. (path, setting, value) or None. Only
    that file's env is read; a gateway or proxy to Claude is left alone."""
    path = Path(config_dir or (Path.home() / ".claude")) / "settings.json"
    try:
        data = json.loads(path.read_text(encoding="utf-8-sig"))
    except (OSError, ValueError):
        return None                    # no settings there, or nothing this adapter should judge: Claude Code speaks
    env = data.get("env") if isinstance(data, dict) else None
    if not isinstance(env, dict):
        return None
    base = env.get("ANTHROPIC_BASE_URL")
    if isinstance(base, str) and base.strip() and normalize_endpoint(base) in lead_endpoints():
        return path, "ANTHROPIC_BASE_URL", base.strip()
    model = env.get("ANTHROPIC_MODEL")
    if isinstance(model, str) and model.strip() and not claude_model(model):
        return path, "ANTHROPIC_MODEL", model.strip()
    return None


def reset_hint(text):
    """'…limit reached|1767225600' → ISO time, 'resets in 2 hours' → '+120m', 'resets 3pm' → '15:00'."""
    m = RESET_EPOCH.search(text)
    if m:
        return dt.datetime.fromtimestamp(int(m.group(1))).astimezone().isoformat(timespec="minutes")
    m = RESET_IN.search(text)
    if m:
        return "+%dm" % (int(m.group(1)) * (60 if m.group(2).lower().startswith("h") else 1))
    m = RESET_AT.search(text)
    if m and (m.group(2) or m.group(3)):
        h, ap = int(m.group(1)), (m.group(3) or "").lower()
        h = h + 12 if ap == "pm" and h < 12 else 0 if ap == "am" and h == 12 else h
        return "%02d:%02d" % (h, int(m.group(2) or 0))
    return None


def main():
    H.utf8_stdio()
    claude = H.find_claude()
    if not claude:
        say("claude CLI not found: the Claude executor is headless Claude Code (or set ORCH_CLAUDE_BIN)")
        return 127
    run_dir = Path(os.environ["ORCH_RUN_DIR"])
    model = os.environ.get("ORCH_MODEL") or DEFAULT_MODEL
    env = H.base_env(keep=("CLAUDE_CONFIG_DIR",))
    home = os.environ.get("CLAUDE_CONFIG_DIR")
    if home and not Path(home).is_dir():
        say("CLAUDE_CONFIG_DIR=%s (profile %s) does not exist; log in there once: CLAUDE_CONFIG_DIR='%s' claude"
            % (home, os.environ.get("ORCH_PROFILE") or "?", home))
        return 1
    # --setting-sources user reloads the user settings of this config dir: an env pointing elsewhere wins over
    # everything orch stripped, so the worker would not reach Claude at all.
    problem = user_settings_problem(home)
    if problem:
        path, setting, value = problem
        say("blocked: %s sets env.%s=%s — this worker would not reach Claude" % (path, setting, value))
        effect = ("every request would go there instead" if setting == "ANTHROPIC_BASE_URL"
                  else "every request would ask for that model instead of Claude")
        report = ("STATUS: BLOCKED\n\norch run claude cannot reach Claude: the user settings this executor reloads "
                  "(--setting-sources user) set env.%s to %s in %s, so %s.\n\n"
                  "Remove that entry from the file's \"env\", or give the profile a config dir without it "
                  "(`orch profile set claude <name> --home <dir>`)." % (setting, value, path, effect))
        try:
            Path(os.environ["ORCH_OUTPUT_FILE"]).write_text(report, encoding="utf-8")
        except (KeyError, OSError):
            pass
        return 1
    env.update({"CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1", "DISABLE_AUTOUPDATER": "1"})
    isolation = ["--setting-sources", "user", "--settings", json.dumps({"disableAllHooks": True})]
    cmd = H.command(claude, model, run_dir, isolation, os.environ.get("ORCH_CLAUDE_EXTRA_ARGS"), say)
    result, rc = H.run(cmd, env)

    if result is None:
        say("claude exited without a result (rc=%s); see the log above" % rc)
        return rc or 1
    H.write_usage(run_dir, result, model)
    text = result.get("result") or ""
    status = result.get("api_error_status")
    if result.get("is_error") or result.get("subtype") != "success":
        say("error: %s" % H.one_line(text or result.get("subtype"), 500))
        if status == 429 or LIMIT_RE.search(text):
            hint = reset_hint(text) or ("+15m" if status == 429 and not LIMIT_RE.search(text) else None)
            if hint:
                (run_dir / "quota_until").write_text(hint + "\n", encoding="utf-8")
            say("Claude usage limit: %s" % H.one_line(text, 300))
            return H.EXIT_QUOTA
        if status == 401 or "/login" in text:
            if os.environ.get("ANTHROPIC_API_KEY"):
                label = "claude" + ("@" + os.environ["ORCH_PROFILE"] if os.environ.get("ORCH_PROFILE") else "")
                say("Claude rejected the API key (401) — check the key of %s (orch profile show)" % label)
            else:
                say("Claude rejected the credentials: log in with `claude` (or check the profile's config dir)")
        return rc or 1
    H.write_output(result)
    say("done: %s turns, %.0f s" % (result.get("num_turns"), (result.get("duration_ms") or 0) / 1000.0))
    return 0


if __name__ == "__main__":
    sys.exit(main())
