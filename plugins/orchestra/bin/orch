#!/bin/sh
# Run as a program, the shell part below finds Python 3.8+ and runs this file with it; Python reads that part as a
# string and goes on to the launcher code. (Keep backslashes out of the shell part: to Python it is a plain string.)
""":"
# The plugin's bin/ is on the Bash tool's PATH in every Claude Code session, and `python3` may be missing there: on
# Windows there is often only `python`, or the Microsoft Store alias. The search and its cache are those of
# hooks/run.sh: the interpreter that passed is kept per platform in $ORCH_HOME/.hook-python-<platform>.
HOME_DIR="${ORCH_HOME:-$HOME/.orchestra}"
CACHE="$HOME_DIR/.hook-python-${OSTYPE:-posix}"
if [ -f "$CACHE" ]; then
  CACHED=""
  IFS= read -r CACHED < "$CACHE" 2>/dev/null
  if [ -n "$CACHED" ] && [ -x "$CACHED" ]; then
    exec "$CACHED" "$0" "$@"
  fi
fi
PY=""
for KIND in real alias; do
  for p in python3 python py; do
    CMD="$(command -v "$p" 2>/dev/null)" || continue
    case "$CMD" in
      *WindowsApps*) [ "$KIND" = real ] && continue ;;
      *) [ "$KIND" = alias ] && continue ;;
    esac
    EXE="$("$p" -c 'import sys; print(sys.executable.replace(chr(92), "/")) if sys.version_info >= (3, 8) else sys.exit(1)' 2>/dev/null)" || continue
    if [ -n "$EXE" ]; then PY="$EXE"; break 2; fi
  done
done
if [ -z "$PY" ]; then
  echo "orch: no Python 3.8+ found (tried python3, python, py)" >&2
  exit 127
fi
mkdir -p "$HOME_DIR" 2>/dev/null
TMP="$CACHE.$$"
if printf '%s\n' "$PY" > "$TMP" 2>/dev/null; then
  mv -f "$TMP" "$CACHE" 2>/dev/null || rm -f "$TMP" 2>/dev/null
fi
exec "$PY" "$0" "$@"
"""
"""orch launcher: run lib/orch_core.py, keeping its compiled code in the personal folder.

Python never caches the bytecode of the script it is started with, and `orch` runs on every hook and status line
update, so compiling all of lib/orch_core.py each time took about 0.14 s of a hook. The code is compiled once and
stored as a key (a hash of the source and the interpreter version) followed by marshal.dumps(); a launcher that finds
a matching key only unmarshals it. Any problem with the cache means compile and run, exactly as before.

The code runs in this module's own namespace, so a test that loads this file as a module gets the real functions and
its patches reach them. The launcher's own names start with an underscore to stay out of the code's way.
"""
import hashlib as _hashlib
import marshal as _marshal
import os as _os
import sys as _sys

_CORE = _os.path.join(_os.path.dirname(_os.path.dirname(_os.path.realpath(__file__))), "lib", "orch_core.py")


def _cache_file():
    home = _os.environ.get("ORCH_HOME") or _os.path.join(_os.path.expanduser("~"), ".orchestra")
    return _os.path.join(home, ".pycache", "orch_core.%s.bin" % _sys.implementation.cache_tag)


def _cache_key(source):
    return _hashlib.sha256(source + _sys.version.encode("utf-8", "replace")).digest()


def _read_cache(path, key):
    """The code stored under `key`, or None when there is no usable entry (missing, another key, corrupt)."""
    try:
        with open(path, "rb") as fh:
            blob = fh.read()
        if blob[:len(key)] == key:
            code = _marshal.loads(blob[len(key):])
            return code if hasattr(code, "co_code") else None
    except Exception:
        pass
    return None


def _write_cache(path, key, code):
    """Replace the cache atomically; any failure only means the next run compiles again."""
    tmp = "%s.%d.tmp" % (path, _os.getpid())
    try:
        _os.makedirs(_os.path.dirname(path), exist_ok=True)
        with open(tmp, "wb") as fh:
            fh.write(key + _marshal.dumps(code))
        _os.replace(tmp, path)
    except Exception:
        try:
            _os.unlink(tmp)
        except Exception:
            pass


def _load(path):
    with open(path, "rb") as fh:
        source = fh.read()
    key = _cache_key(source)
    try:
        cache = _cache_file()
    except Exception:
        cache = None
    if cache is not None:
        code = _read_cache(cache, key)
        if code is not None:
            return code
    code = compile(source, path, "exec")
    if cache is not None and not _sys.dont_write_bytecode:
        _write_cache(cache, key, code)
    return code


exec(_load(_CORE), globals())
