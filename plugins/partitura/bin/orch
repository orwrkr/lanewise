#!/bin/sh
# Run as a program, the shell part below finds Python 3.8+ and runs this file with it; Python reads that part as a
# string and goes on to the launcher code. (Keep backslashes out of the shell part: to Python it is a plain string.)
""":"
# The plugin's bin/ is on the Bash tool's PATH in every Claude Code session, and `python3` may be missing there: on
# Windows there is often only `python`, or the Microsoft Store alias. The search and its cache are those of
# hooks/run.sh: the interpreter that passed is kept per platform in $ORCH_HOME/.hook-python-<platform>.
if [ -n "${ORCH_HOME:-}" ]; then
  HOME_DIR="$ORCH_HOME"
elif [ -d "$HOME/.partitura" ]; then
  HOME_DIR="$HOME/.partitura"
elif [ -d "$HOME/.orchestra" ]; then
  HOME_DIR="$HOME/.orchestra"
else
  HOME_DIR="$HOME/.partitura"
fi
CACHE="$HOME_DIR/.hook-python-${OSTYPE:-posix}"
if [ -f "$CACHE" ]; then
  CACHED=""
  IFS= read -r CACHED < "$CACHE" 2>/dev/null
  if [ -n "$CACHED" ] && [ -x "$CACHED" ]; then
    exec "$CACHED" "$0" "$@"
  fi
fi
PY=""
for KIND in real alias; do
  for p in python3 python py; do
    CMD="$(command -v "$p" 2>/dev/null)" || continue
    case "$CMD" in
      *WindowsApps*) [ "$KIND" = real ] && continue ;;
      *) [ "$KIND" = alias ] && continue ;;
    esac
    EXE="$("$p" -c 'import sys; print(sys.executable.replace(chr(92), "/")) if sys.version_info >= (3, 8) else sys.exit(1)' 2>/dev/null)" || continue
    if [ -n "$EXE" ]; then PY="$EXE"; break 2; fi
  done
done
if [ -z "$PY" ]; then
  echo "orch: no Python 3.8+ found (tried python3, python, py)" >&2
  exit 127
fi
mkdir -p "$HOME_DIR" 2>/dev/null
TMP="$CACHE.$$"
if printf '%s\n' "$PY" > "$TMP" 2>/dev/null; then
  mv -f "$TMP" "$CACHE" 2>/dev/null || rm -f "$TMP" 2>/dev/null
fi
exec "$PY" "$0" "$@"
"""
"""orch launcher: run the parts of lib/orch_core/, keeping their compiled code in the personal folder.

The CLI is split into lib/orch_core/NN-<area>.py. The parts run in file-name order, each compiled under its own path,
so a traceback names the part that failed. They share this module's namespace, so a part may use what an earlier part
defines, as one file did before.

Python never caches the bytecode of the script it is started with, and `orch` runs on every hook and status line
update, so compiling the parts each time took about 0.14 s of a hook. They are compiled once and stored as a key (a
hash of every part's file name and source, and the interpreter version) followed by marshal.dumps() of the code
objects; a launcher that finds a matching key only unmarshals them. Any problem with the cache means compile and run,
exactly as before.

The code runs in this module's own namespace, so a test that loads this file as a module gets the real functions and
its patches reach them. The launcher's own names start with an underscore to stay out of the code's way.
"""
import hashlib as _hashlib
import marshal as _marshal
import os as _os
import re as _re
import sys as _sys

_CORE_DIR = _os.path.join(_os.path.dirname(_os.path.dirname(_os.path.realpath(__file__))), "lib", "orch_core")
_PART_NAME = _re.compile(r"[0-9][0-9]-[^\\/]+\.py$")


def _cache_file():
    home = _os.environ.get("ORCH_HOME")
    if not home:               # the same order as ORCH_HOME in 00-header.py: new name, old name, new name
        new = _os.path.join(_os.path.expanduser("~"), ".partitura")
        old = _os.path.join(_os.path.expanduser("~"), ".orchestra")
        home = new if _os.path.isdir(new) or not _os.path.isdir(old) else old
    return _os.path.join(home, ".pycache", "orch_core.%s.bin" % _sys.implementation.cache_tag)


def _parts():
    """[(path, source)] of lib/orch_core/NN-*.py in file-name order; an empty list when there are none."""
    try:
        names = _os.listdir(_CORE_DIR)
    except OSError:
        return []
    out = []
    for name in sorted(names):
        path = _os.path.join(_CORE_DIR, name)
        if _PART_NAME.match(name) and _os.path.isfile(path):
            with open(path, "rb") as fh:
                out.append((path, fh.read()))
    return out


def _cache_key(parts):
    """A hash over every part's file name and source, then the interpreter version."""
    digest = _hashlib.sha256()
    for path, source in parts:
        digest.update(_os.path.basename(path).encode("utf-8") + b"\0" + source + b"\0")
    digest.update(_sys.version.encode("utf-8", "replace"))
    return digest.digest()


def _read_cache(path, key):
    """The code objects stored under `key`, or None when there is no usable entry (missing, another key, corrupt)."""
    try:
        with open(path, "rb") as fh:
            blob = fh.read()
        if blob[:len(key)] == key:
            codes = _marshal.loads(blob[len(key):])
            if isinstance(codes, (list, tuple)) and codes and all(hasattr(c, "co_code") for c in codes):
                return list(codes)
    except Exception:
        pass
    return None


def _write_cache(path, key, codes):
    """Replace the cache atomically; any failure only means the next run compiles again."""
    tmp = "%s.%d.tmp" % (path, _os.getpid())
    try:
        _os.makedirs(_os.path.dirname(path), exist_ok=True)
        with open(tmp, "wb") as fh:
            fh.write(key + _marshal.dumps(list(codes)))
        _os.replace(tmp, path)
    except Exception:
        try:
            _os.unlink(tmp)
        except Exception:
            pass


def _load():
    """The compiled parts, from the cache when its key matches; raises SystemExit(1) when there are no parts."""
    parts = _parts()
    if not parts:
        _sys.stderr.write("orch: no code parts found in %s (expected NN-<area>.py)\n" % _CORE_DIR)
        raise SystemExit(1)
    key = _cache_key(parts)
    try:
        cache = _cache_file()
    except Exception:
        cache = None
    if cache is not None:
        codes = _read_cache(cache, key)
        if codes is not None:
            return codes
    codes = [compile(source, path, "exec") for path, source in parts]
    if cache is not None and not _sys.dont_write_bytecode:
        _write_cache(cache, key, codes)
    return codes


def _run():
    for code in _load():
        exec(code, globals())


_run()
